{
  "appId": "com.tapehead.pro",
  "appName": "Tapehead Pro",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0A0A0C"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#0A0A0C",
    "preferredContentMode": "mobile",
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0A0A0C",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0A0C"
    }
  }
}
