# Tapehead Pro Cloud AI
# Set these in Vercel Project Settings > Environment Variables.
OPENAI_API_KEY=
# Optional: change the model. Default: gpt-5.6-sol
# Cloud AI is limited server-side to 30 requests per user per hour.
OPENAI_MODEL=gpt-5.6-sol

# Used by /www/api/ai.js to verify the signed-in Supabase user.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server-only Supabase service role key. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Tapehead Pro / Pesapal API 3.0 (server-only; never expose these in frontend JS)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# sandbox (default, test money) or live (real money)
PESAPAL_ENV=sandbox
# Optional. Leave empty to let the app find/register the IPN URL automatically.
PESAPAL_IPN_ID=
# Tapehead Pro is always charged in USD (fixed in code).
# Optional price overrides in USD (defaults shown; leave unset to use them):
# PRO_MONTHLY_PRICE=4.99
# PRO_YEARLY_PRICE=29
# PRO_LIFETIME_PRICE=49
PUBLIC_APP_URL=https://tapehead-pro.vercel.app
